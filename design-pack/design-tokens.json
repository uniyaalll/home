      "color-line": "#282828",
      "color-record-line": "#ffffff1f",
      "color-fill": "#ffffff0d",
      "color-glass": "#0a0a0a47",
      "color-scheme": "dark"
    },
    "light": {
      "color-bg": "#f4f4f4",
      "color-fg": "#0a0a0a",
      "color-muted": "#0a0a0aa3",
      "color-muted-rgba": "rgba(10,10,10,0.639)",
      "color-online": "#00aa44",
      "color-line": "#d0d0d0",
      "color-record-line": "#0000001f",
      "color-fill": "#0000000d",
      "color-glass": "#ffffffa8",
      "color-scheme": "light"
    }
  },
  "themePersistence": {
    "htmlAttribute": "data-theme",
    "values": ["dark", "light"],
    "localStorageKey": "uniyaalll-theme",
    "bootScriptPreventsFlash": true
  },
  "spacing": {
    "tailwindSpacingRem": 0.25,
    "previewPad": "clamp(1rem, 3vw, 3rem)",
    "previewPadPxRange": [16, 48],
    "contentBottomRem": 2.5,
    "contentBottomPx": 40,
    "barHeight": "clamp(4rem, 7vw, 6rem)",
    "barHeightPxRange": [64, 96],
    "previewFadeRem": 6,
    "previewFadePx": 96,
    "sidebarWidthRem": 18,
    "sidebarWidthPx": 288,
    "windowRadiusPx": 0,
    "rowRadiusPx": 0,
    "blurHeaderPx": 6,
    "transition": "0.2s ease-out"
  },
  "layout": {
    "skin": "flat",
    "shell": "finder",
    "desktopBreakpointPx": 768,
    "sidebar": {
      "desktopWidthPx": 288,
