    "referenceSite": "https://tr.af",
    "description": "Machine-readable visual identity for the UNIYAALLL finder-style portfolio (tr.af replica).",
    "fontFile": "departure_mono-s.p.29iafaar4mfrt.woff2",
    "fontFileBytes": 13912,
    "fontFormat": "woff2"
  },
  "font": {
    "familyCss": "departure",
    "fallbackFamilyCss": "departure Fallback",
    "stack": ["departure", "departure Fallback"],
