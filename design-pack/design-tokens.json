      "lineHeightPxAt14": 22.75,
      "fontWeight": 400,
      "letterSpacing": "0",
      "textTransform": "uppercase",
      "fontStyle": "normal",
      "webkitFontSmoothing": "antialiased",
      "textRendering": "optimizeLegibility"
    },
    "notes": {
      "articleColorToken": "muted",
      "headingColorToken": "fg",
      "inheritsUppercaseFromBody": true,
      "h1MarginBottomRem": 2,
      "h2MarginTopRem": 3,
